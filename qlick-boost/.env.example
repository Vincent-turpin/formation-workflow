# Copiez ce fichier en .env (ou renseignez ces variables chez votre hébergeur)
NODE_ENV=production
BASE_URL=https://boost.qlick.fr
# Générer avec : openssl rand -hex 32
QLICK_SECRET=
# Chemin du fichier de données, sur un disque persistant
QLICK_DB=/data/db.json
# Compte administrateur Qlick (espace agence /admin), créé au démarrage
QLICK_ADMIN_EMAIL=admin@qlick.fr
QLICK_ADMIN_PASSWORD=
# Réponses aux avis par IA (optionnel)
ANTHROPIC_API_KEY=
# Compte et roue de démonstration (/play/demo) : 1 pour activer
QLICK_DEMO=1
QLICK_DEMO_PASSWORD=
# Si renseigné, la création de compte exige ce code (à donner à vos clients)
QLICK_SIGNUP_CODE=
